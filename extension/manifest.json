{
    "manifest_version": 3,
    "name": "JobProof",
    "version": "1.0",
    "description": "AI-powered job scam detection",
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": ["http://127.0.0.1/*"],
    "content_scripts": [
        {
            "matches": [
                "http://localhost/*", "http://127.0.0.1/*",
                "https://*.indeed.com/jobs*", "https://*.indeed.com/viewjob*",
                "https://*.indeed.com/m/viewjob*"
            ],
            "js": ["indeed.js", "content.js"],
            "css": ["styles.css"],
            "run_at": "document_idle"
        }
    ]
}
